{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-write-text-file",
    "opener:default",
    "allow-list-subdir-names",
    "allow-remove-mod-dir",
    "allow-probe-mod-remote",
    "allow-acquire-mod",
    "allow-cancel-mod-acquire",
    "allow-scrape-mod-page-meta",
    "allow-weidu-install",
    "allow-weidu-backup"
  ]
}
