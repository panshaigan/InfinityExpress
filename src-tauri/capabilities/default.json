{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-check-install-compatibility",
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:default",
    "fs:allow-write-text-file",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    "allow-list-subdir-names",
    "allow-read-text-file",
    "allow-file-is-nonempty",
    "allow-read-text-file-tail",
    "allow-write-text-file-path",
    "allow-append-text-file",
    "allow-ensure-dir",
    "allow-validate-creatable-dir",
    "allow-game-dir-has-weidu-log",
    "allow-dir-is-empty",
    "allow-remove-mod-dir",
    "allow-probe-mod-remote",
    "allow-acquire-mod",
    "allow-cancel-mod-acquire",
    "allow-scrape-mod-page-meta",
    "allow-weidu-install",
    "allow-weidu-backup",
    "allow-take-fresh-install-env-flag",
    "allow-bundled-tools",
    "allow-game-shortcuts"
  ]
}
