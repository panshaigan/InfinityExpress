{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "InfinityExpress",
  "version": "0.10.0",
  "identifier": "com.infinityexpress.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "iNfinity eXpress",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/weidu/": "weidu/",
      "resources/7zip/": "7zip/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "UPDATER_PUBKEY",
      "endpoints": [
        "https://github.com/panshaigan/InfinityExpress/releases/latest/download/latest.json"
      ]
    }
  }
}
